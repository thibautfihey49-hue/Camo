<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="40dp"
    android:gravity="center_horizontal"
    android:background="#0F0F0F">

    <TextView 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content"
        android:text="📹 Camo" 
        android:textSize="34sp" 
        android:textColor="#FFFFFF" 
        android:layout_marginBottom="5dp"
        android:textStyle="bold"/>

    <TextView 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content"
        android:text="Comme VDO.Ninja" 
        android:textSize="16sp" 
        android:textColor="#666666" 
        android:layout_marginBottom="45dp"/>

    <TextView 
        android:id="@+id/codeText"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"
        android:text="🔑 bleu-soleil-42" 
        android:textSize="26sp" 
        android:textColor="#00FF88" 
        android:gravity="center"
        android:paddingVertical="25dp"
        android:background="#1A1A1A"
        android:layout_marginBottom="35dp"
        android:textStyle="bold"/>

    <TextView 
        android:id="@+id/statusText"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"
        android:text="1. Clique Démarrer\n2. Partage le code\n3. Sur vdo.ninja/?room=CODE" 
        android:textSize="15sp" 
        android:textColor="#AAAAAA" 
        android:gravity="center"
        android:layout_marginBottom="40dp"
        android:lineSpacingExtra="6dp"/>

    <Button 
        android:id="@+id/btnStart"
        android:layout_width="match_parent" 
        android:layout_height="65dp"
        android:text="📹 DÉMARRER MA CAMÉRA" 
        android:backgroundTint="#00C853" 
        android:textColor="#FFFFFF"
        android:textSize="18sp" 
        android:layout_marginBottom="15dp"
        android:textStyle="bold"/>

    <Button 
        android:id="@+id/btnCopy"
        android:layout_width="match_parent" 
        android:layout_height="55dp"
        android:text="📋 COPIER LE CODE" 
        android:backgroundTint="#2196F3" 
        android:textColor="#FFFFFF"
        android:textSize="16sp" 
        android:layout_marginBottom="15dp"/>

    <Button 
        android:id="@+id/btnWatch"
        android:layout_width="match_parent" 
        android:layout_height="55dp"
        android:text="📺 VOIR LA VIDÉO" 
        android:backgroundTint="#7B1FA2" 
        android:textColor="#FFFFFF"
        android:textSize="16sp"/>

</LinearLayout>
